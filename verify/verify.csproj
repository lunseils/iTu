<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Verify</AssemblyName>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\iTu\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <None Include="..\iTu\Core\ocr.ps1" Link="ocr.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\iTu\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
    <Compile Include="..\iTu\RecordPanel.cs" Link="RecordPanel.cs" />
  </ItemGroup>
</Project>
