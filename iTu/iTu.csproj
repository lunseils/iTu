<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      刻意使用 net10.0-windows（不带版本号）：
      若写成 net10.0-windows10.0.19041.0，SDK 会自动引入
      Microsoft.Windows.SDK.NET.dll（约 25MB 的 WinRT 投影）。
      OCR 改由系统自带 PowerShell 调用 WinRT 完成，
      从而让框架依赖单文件发布体积仅约 500KB。
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>iTu</AssemblyName>
    <RootNamespace>iTu</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CA1416;CS0649;WFO1000</NoWarn>
    <Product>iTu</Product>
    <AssemblyTitle>iTu - 截图工具</AssemblyTitle>
    <!--
      版本号用来区分"构建"：录制面板加了暂停/取消后升 1.1.0。
      旧实例常驻托盘并占着热键时，用户很容易以为改动没生效，
      托盘提示 / 关于-诊断 / 日志里都会打印这个号，便于自证在跑哪一份。
    -->
    <Version>1.1.19</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- OCR 脚本嵌入 exe（不再作为独立文件发布）：运行时从资源读出，
         以 powershell -EncodedCommand 执行，发布目录只需一个 iTu.exe。 -->
    <EmbeddedResource Include="Core\ocr.ps1" LogicalName="iTu.OcrScript" />
  </ItemGroup>

</Project>
